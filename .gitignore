# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# Provisioned voice assets (see scripts/prepare-reader-voice.sh).
/assets/kokoro/*
!/assets/kokoro/README.txt
/assets/kokoro-v1/*
!/assets/kokoro-v1/README.txt

# Downloaded model weights stay out of version control.
/models/

# Experimental Phonon Core ML runtime (see scripts/prepare-reader-phonon.sh).
/native/PhononCore.xcframework/
/native/core.zip
/native/core.zip.part
